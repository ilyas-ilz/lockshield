# --- Database ---
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/lockshield?retryWrites=true&w=majority

# --- Auth.js ---
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Seed (first admin user, seed script only) ---
SEED_ADMIN_EMAIL=admin@lockshield.ae
SEED_ADMIN_PASSWORD=change-me-before-seeding
SEED_ADMIN_NAME="Lock Shield Admin"

# --- Storage (Media Uploads) ---
# ZERO KEYS REQUIRED FOR LOCAL DEVELOPMENT:
# When Cloudinary variables below are omitted or left blank, uploads automatically
# write to local disk (public/uploads/) and are served directly by Next.js.
# For production deployments (e.g. Vercel), populate these keys to automatically
# route uploads to Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Public site origin (CORS allowlist for public API + canonical URLs) ---
SITE_URL=https://lockshield.ae
